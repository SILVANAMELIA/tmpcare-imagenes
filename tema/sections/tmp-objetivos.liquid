{%- style -%}
.tmp-obj{padding:64px 0;background:#fff}
.tmp-obj__head{text-align:center;max-width:72rem;margin:0 auto 3.2rem}
.tmp-obj__head h2{font-family:var(--font-body-family);font-weight:800;color:#041F3D;font-size:clamp(3rem,4.4vw,4.4rem);letter-spacing:-.02em;margin:0 0 1rem}
.tmp-obj__head h2 em{font-family:'Playfair Display',Georgia,serif;font-weight:400;color:#2A6FDB}
.tmp-obj__head p{font-size:1.7rem;color:#2d3a55;margin:0}
.tmp-obj__gift{display:inline-block;margin-top:1.4rem;background:#EAF2FB;color:#14305E;border-radius:999px;padding:.6rem 1.4rem;font-weight:700;font-size:1.25rem;letter-spacing:.08em}
.tmp-obj__grid{display:grid;grid-template-columns:repeat(1,1fr);gap:2rem}
@media(min-width:750px){.tmp-obj__grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1100px){.tmp-obj__grid{grid-template-columns:repeat(3,1fr)}}
.tmp-obj__card{background:#F6FAFE;border:1px solid #E1EBF7;border-radius:24px;overflow:hidden;display:flex;flex-direction:column}
.tmp-obj__card img{width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;display:block;background:#EAF2FB}
.tmp-obj__body{padding:2rem 2.2rem 2.4rem;display:flex;flex-direction:column;gap:.8rem;flex:1}
.tmp-obj__body h3{margin:0;font-family:var(--font-body-family);font-weight:800;font-size:2.2rem;color:#041F3D}
.tmp-obj__inc{font-size:1.4rem;color:#2d3a55;margin:0}
.tmp-obj__price{font-size:1.9rem;font-weight:800;color:#041F3D}
.tmp-obj__price s{font-weight:400;color:#7a879e;font-size:1.5rem;margin-left:.6rem}
.tmp-obj__price span{background:#2A6FDB;color:#fff;font-size:1.2rem;border-radius:999px;padding:.3rem .8rem;margin-left:.6rem;vertical-align:middle}
.tmp-obj__acts{display:flex;gap:1rem;margin-top:auto;padding-top:1rem;flex-wrap:wrap}
.tmp-obj__acts .tmp-btn{min-height:4.6rem;padding:0 2rem;font-size:1.45rem;flex:1}
.tmp-obj__acts form{flex:1;display:flex}.tmp-obj__acts form button{width:100%;border:0;cursor:pointer}
{%- endstyle -%}
<section class="tmp-obj" id="objetivos">
  <div class="page-width">
    <div class="tmp-obj__head">
      <h2>{{ section.settings.h_a }} <em>{{ section.settings.h_b }}</em></h2>
      <p>{{ section.settings.sub }}</p>
      {%- if section.settings.gift != blank -%}<span class="tmp-obj__gift">{{ section.settings.gift }}</span>{%- endif -%}
    </div>
    <div class="tmp-obj__grid">
      {%- for b in section.blocks -%}
        {%- assign p = all_products[b.settings.pack] -%}
        <div class="tmp-obj__card" {{ b.shopify_attributes }}>
          <a href="{{ p.url }}">{%- if b.settings.image -%}{{ b.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: b.settings.title }}{%- elsif p.featured_image -%}{{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}</a>
          <div class="tmp-obj__body">
            <h3>{{ b.settings.title }}</h3>
            <p class="tmp-obj__inc">{{ b.settings.incluye }}</p>
            {%- if p -%}<div class="tmp-obj__price">{{ p.price | money }}{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s><span>−10 %</span>{%- endif -%}</div>{%- endif -%}
            <div class="tmp-obj__acts">
              {%- if b.settings.link != blank -%}<a class="tmp-btn tmp-btn--sec" href="{{ b.settings.link }}">Ver protocolo</a>{%- endif -%}
              {%- if p -%}
              <form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1">
                <button type="submit" class="tmp-btn tmp-btn--pri">Añadir · {{ p.price | money }}</button></form>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"TMP · ¿Qué quieres cuidar?","settings":[
{"type":"text","id":"h_a","label":"Título","default":"¿Qué quieres"},{"type":"text","id":"h_b","label":"Título (cursiva)","default":"cuidar?"},
{"type":"text","id":"sub","label":"Subtítulo"},{"type":"text","id":"gift","label":"Etiqueta"}],
"blocks":[{"type":"objetivo","name":"Objetivo","settings":[
{"type":"text","id":"title","label":"Objetivo"},{"type":"text","id":"incluye","label":"Qué incluye"},
{"type":"product","id":"pack","label":"Pack"},{"type":"url","id":"link","label":"Ver protocolo (colección)"},{"type":"image_picker","id":"image","label":"Imagen (opcional)"}]}],
"presets":[{"name":"TMP · ¿Qué quieres cuidar?"}]}
{% endschema %}
