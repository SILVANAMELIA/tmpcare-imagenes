{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- style -%}
.tmp-tabs{padding:64px 0;background:#E9ECEF}
.tmp-tabs h2{text-align:center;font-family:var(--font-body-family);font-weight:800;color:#041F3D;font-size:clamp(3rem,4.4vw,4.4rem);letter-spacing:-.02em;margin:0 0 2rem}
.tmp-tabs h2 em{font-family:'Playfair Display',Georgia,serif;font-weight:400;color:#CA963E}
.tmp-tabs__nav{display:flex;justify-content:center;gap:.8rem;flex-wrap:wrap;margin-bottom:2.8rem}
.tmp-tabs__nav button{border:1.5px solid #C9CFD6;background:#fff;color:#041F3D;border-radius:999px;padding:1rem 2rem;font-size:1.45rem;font-weight:700;cursor:pointer}
.tmp-tabs__nav button[aria-selected=true]{background:#041F3D;border-color:#041F3D;color:#fff}
.tmp-tabs__panel[hidden]{display:none}
.tmp-tabs__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.6rem;list-style:none;padding:0;margin:0}
@media(min-width:990px){.tmp-tabs__grid{grid-template-columns:repeat(4,1fr);gap:2.4rem}}
.tmp-tabs__more{text-align:center;margin-top:2.8rem}
{%- endstyle -%}
<section class="tmp-tabs" id="tmptabs-{{ section.id }}">
  <div class="page-width">
    <h2>{{ section.settings.h_a }} <em>{{ section.settings.h_b }}</em></h2>
    <div class="tmp-tabs__nav" role="tablist">
      {%- for b in section.blocks -%}<button role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-t="{{ forloop.index }}">{{ b.settings.label }}</button>{%- endfor -%}
    </div>
    {%- for b in section.blocks -%}
      <div class="tmp-tabs__panel" data-p="{{ forloop.index }}" {% unless forloop.first %}hidden{% endunless %} {{ b.shopify_attributes }}>
        <ul class="tmp-tabs__grid">
          {%- for product in b.settings.collection.products limit: section.settings.n -%}
            <li>{% render 'card-product', card_product: product, media_aspect_ratio: 'square', image_shape: 'default', show_secondary_image: false, show_vendor: false, show_rating: false, section_id: section.id, quick_add: 'standard' %}</li>
          {%- endfor -%}
        </ul>
        <div class="tmp-tabs__more"><a class="tmp-btn tmp-btn--sec" href="{{ b.settings.collection.url }}">Ver todos</a></div>
      </div>
    {%- endfor -%}
  </div>
</section>
<script>
(function(){var r=document.getElementById('tmptabs-{{ section.id }}');if(!r)return;r.querySelectorAll('[role=tab]').forEach(function(b){b.addEventListener('click',function(){r.querySelectorAll('[role=tab]').forEach(function(x){x.setAttribute('aria-selected',x===b)});r.querySelectorAll('.tmp-tabs__panel').forEach(function(p){p.hidden=p.dataset.p!==b.dataset.t})})})})();
</script>
{% schema %}
{"name":"TMP · Favoritos","settings":[{"type":"text","id":"h_a","label":"Título","default":"Favoritos"},{"type":"text","id":"h_b","label":"Título (cursiva)","default":"de este mes"},{"type":"range","id":"n","label":"Productos por pestaña","min":4,"max":12,"step":1,"default":8}],
"blocks":[{"type":"tab","name":"Pestaña","settings":[{"type":"text","id":"label","label":"Nombre"},{"type":"collection","id":"collection","label":"Colección"}]}],
"presets":[{"name":"TMP · Favoritos"}]}
{% endschema %}
