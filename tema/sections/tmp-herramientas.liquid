{%- style -%}
.tmp-tools{padding:64px 0;background:#fff}
.tmp-tools__head{text-align:center;margin-bottom:3rem}
.tmp-tools__head h2{font-family:var(--font-body-family);font-weight:800;color:#041F3D;font-size:clamp(3rem,4.4vw,4.4rem);letter-spacing:-.02em;margin:0 0 1rem}
.tmp-tools__head p{font-size:1.7rem;color:#2d3a55;margin:0}
.tmp-tools__grid{display:grid;gap:2rem;grid-template-columns:1fr}
@media(min-width:750px){.tmp-tools__grid{grid-template-columns:repeat(3,1fr)}}
.tmp-tools__card{background:#E9ECEF;border:1px solid #DDE2E7;border-radius:24px;padding:3rem 2.6rem;display:flex;flex-direction:column;gap:1rem}
.tmp-tools__ico{font-size:3.2rem;line-height:1}
.tmp-tools__card h3{margin:0;font-family:var(--font-body-family);font-weight:800;font-size:2.2rem;color:#041F3D}
.tmp-tools__card p{margin:0;font-size:1.5rem;color:#2d3a55;flex:1}
.tmp-tools__card .tmp-btn{align-self:flex-start;margin-top:1rem}
{%- endstyle -%}
<section class="tmp-tools"><div class="page-width">
  <div class="tmp-tools__head"><h2>{{ section.settings.title }}</h2><p>{{ section.settings.sub }}</p></div>
  <div class="tmp-tools__grid">{%- for b in section.blocks -%}
    <div class="tmp-tools__card" {{ b.shopify_attributes }}><div class="tmp-tools__ico">{{ b.settings.icon }}</div><h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p>{%- if b.settings.btn != blank -%}<a class="tmp-btn tmp-btn--pri" href="{{ b.settings.link }}">{{ b.settings.btn }}</a>{%- endif -%}</div>
  {%- endfor -%}</div>
</div></section>
{% schema %}
{"name":"TMP · Herramientas","settings":[{"type":"text","id":"title","label":"Título","default":"Herramientas para elegir bien"},{"type":"text","id":"sub","label":"Subtítulo"}],
"blocks":[{"type":"tool","name":"Herramienta","settings":[{"type":"text","id":"icon","label":"Icono (emoji)"},{"type":"text","id":"title","label":"Título"},{"type":"textarea","id":"text","label":"Texto"},{"type":"text","id":"btn","label":"Botón"},{"type":"url","id":"link","label":"Enlace"}]}],
"presets":[{"name":"TMP · Herramientas"}]}
{% endschema %}
